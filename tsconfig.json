{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/auth-sdk": ["./src/lib/app-auth-sdk.tsx"],
      "@/lib/endpoints-sdk": ["./src/lib/app-endpoints-sdk.ts"],
      "@/lib/backend-sdk": ["./src/lib/app-backend-sdk.ts"],
      "@/lib/file-upload-sdk": ["./src/lib/app-file-upload-sdk.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "functions", "tests"]
}
