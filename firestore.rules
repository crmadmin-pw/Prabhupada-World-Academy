rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model and Access Architecture
    // ===============================================================
    //
    // Private application data access is routed through authenticated Next.js
    // endpoints and the Firebase Admin SDK. The browser's only direct
    // Firestore access is read-only, UID-owned query versions and individual
    // reminder inbox messages in RealtimeClients. Routing/recipient lists and
    // query filters are never client-readable.
    //
    // Server-managed collection families include:
    // - Identity/PII: Users, Guides, FolkResidencies, PushSubscriptions,
    //   AccountLinkRequests
    // - Sadhana: SadhanaEntries, SadhanaFields, SadhanaMonthlySummaries,
    //   SadhanaPeriodSummaries, SadhanaPeriodSummaryMeta,
    //   AshrayChecklist, AshrayLevels, AshrayUpgradeRequests
    // - Bhakti Vriksha: BvGroups, BvGroupMembers, BvGroupRequests,
    //   BvMemberRegistrations, BvSessions, BvAttendance, BvQuizzes,
    //   BvQuizSubmissions, BvslPreachingEntries, BvslWeeklyPlans
    // - Attendance/Jigyasa: AttendanceEvents, AttendanceSessions,
    //   AttendanceParticipants, AttendanceRecords, AttendanceVolunteers,
    //   ChallengeEnrollments, JigyasaRegistrations,
    //   JigyasaSessionAttendance, JigyasaProcessedFiles
    // - Residency operations: Services, ServiceAllocations,
    //   ServiceAvailability, ServicePreferences, ServiceRatings,
    //   ServiceSwaps, CleanlinessRooms, CleanlinessInspections,
    //   CleanlinessReviewRequests, RentPayments, Trips,
    //   UnavailabilityRequests, ResidencyTransferRequests
    // - Leadership/administration: Meetings, MinutesOfMeeting,
    //   OneToOneMeetings, GuideTransferRequests, PreachingReportGoals,
    //   Config, SkillCatalog, UserSkills, TagMangoSyncLog, RateLimits
    // - Realtime registry/clocks: RealtimeQuerySubscriptions,
    //   RealtimeCollectionVersions, RealtimeIdentities
    //
    // These documents contain private information, role flags, operational
    // records, or system configuration. No document is client-readable or
    // client-writable. Firebase Admin access is governed by IAM and bypasses
    // these rules.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return isAuthenticated() &&
        (!('uid' in request.resource.data) ||
         request.resource.data.uid == request.auth.uid);
    }

    function uidNotModified() {
      return isAuthenticated() &&
        (!('uid' in request.resource.data) ||
         request.resource.data.uid == resource.data.uid);
    }

    // Domain validator for the server-only architecture. There are no valid
    // untrusted client documents, regardless of their shape or ownership.
    // The false first operand guarantees that the remaining reusable ownership
    // validators are never evaluated for a client request.
    function isValidServerOnlyDocument() {
      return false &&
        isAuthenticated() &&
        isOwner(request.auth.uid) &&
        uidUnchanged() &&
        uidNotModified();
    }

    // ===============================================================
    // Default Deny
    // ===============================================================
    // The owner's explicit subcollections below are the only exceptions.
    // Writes remain server-only through Firebase Admin SDK.

    // Only opaque query revisions, never business data or query filters.
    // UID ownership is enforced for both single-document and query listeners.
    match /RealtimeClients/{uid}/queries/{queryToken} {
      allow read: if isOwner(uid);
      allow create, update, delete: if isValidServerOnlyDocument();
    }

    // Recipient-specific reminders only; server routing lists and source
    // broadcasts remain private. Clients cannot create or retarget messages.
    match /RealtimeClients/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid);
      allow create, update, delete: if isValidServerOnlyDocument();
    }

    // Covers top-level documents and every nested subcollection. The explicit
    // validator call makes the intended server-only policy unambiguous.

    match /{document=**} {
      allow read, create, update, delete: if isValidServerOnlyDocument();
    }
  }
}
